# =============================================================================
# 鱼课堂 (Koi Commune) — Frontend Web 多阶段构建
# =============================================================================
# 阶段 1: 构建前端产物
FROM node:20-bookworm-slim AS builder

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /src

# 利用 Docker 缓存：先安装依赖，再复制源码
COPY frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml frontend/package.json frontend/.npmrc ./
COPY frontend/turbo.json frontend/tsconfig.json ./

COPY frontend/apps ./apps
COPY frontend/packages ./packages

RUN pnpm install --frozen-lockfile

# 分别构建 Web / Weapp，避免两端共用同一套 API 地址
ARG KOI_API_BASE_URL=/backend
ARG KOI_WEAPP_API_BASE_URL=https://api.koimune.com
RUN printf 'KOI_API_BASE_URL=%s\n' "$KOI_API_BASE_URL" > .env.production.local \
    && pnpm run build:web
RUN printf 'KOI_API_BASE_URL=%s\n' "$KOI_WEAPP_API_BASE_URL" > .env.production.local \
    && pnpm run build:weapp

# =============================================================================
# 阶段 2: 运行时 nginx
FROM nginx:1.30.1-alpine

COPY frontend/apps/web/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /src/apps/web/dist /usr/share/nginx/html
COPY --from=builder /src/apps/miniapp/dist /opt/koi/weapp-dist
COPY frontend/apps/miniapp/project.config.json /opt/koi/project.config.json.template

RUN printf '%s\n' \
    '#!/bin/sh' \
    'set -eu' \
    '' \
    'SOURCE_DIR=/opt/koi/weapp-dist' \
    'TARGET_DIR=/opt/exported-weapp-dist' \
    'PROJECT_CONFIG_TEMPLATE=/opt/koi/project.config.json.template' \
    '' \
    'if [ -d "$SOURCE_DIR" ]; then' \
    '  mkdir -p "$TARGET_DIR"' \
    '  rm -rf "$TARGET_DIR"/*' \
    '  cp -R "$SOURCE_DIR"/. "$TARGET_DIR"/' \
    '' \
    '  if [ -f "$PROJECT_CONFIG_TEMPLATE" ]; then' \
    "    sed 's#\"miniprogramRoot\": \"./dist\"#\"miniprogramRoot\": \".\"#' \\" \
    '      "$PROJECT_CONFIG_TEMPLATE" > "$TARGET_DIR/project.config.json"' \
    '  fi' \
    'fi' \
    '' \
    'exec /docker-entrypoint.sh "$@"' \
    > /usr/local/bin/export-weapp-entrypoint.sh \
 && chmod +x /usr/local/bin/export-weapp-entrypoint.sh

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/export-weapp-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
