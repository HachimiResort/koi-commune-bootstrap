# Koi Commune 一键启动环境变量模板。
# 复制为 `.env` 后填写真实配置；不要提交包含密钥的 `.env`。

# ---- 数据库与缓存 ----
# 生产环境必须替换示例密码。
POSTGRES_PASSWORD=please_change_postgres_password
REDIS_PASSWORD=please_change_redis_password

# ---- 安全 ----
# 生产环境请使用足够长的随机值。
JWT_SECRET=please_change_this_secret_key
ADMIN_PASSWORD=please_change_admin_password

# AI 模型 API Key 加密密钥，建议生成 32 字节随机值。
APP_AI_API_KEY_ENCRYPTION_KEY=please_change_32_byte_secret_key
# 仅使用 CDK / 充值能力时配置。
APP_BILLING_CDK_ENCRYPTION_KEY=

# ---- 邮件 SMTP（注册验证码和邮件通知）----
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=no-reply@example.com
SPRING_MAIL_PASSWORD=please_change_this_smtp_authorization_code
SPRING_MAIL_SMTP_SSL_ENABLE=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=false
APP_AUTH_REGISTER_VERIFICATION_FROM=no-reply@example.com

# ---- 阿里云听悟 ASR（音视频转写）----
TINGWU_APP_KEY=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# ---- 媒体处理 ----
# 默认在后端容器内使用 ffmpeg 处理媒体，并将结果上传到对象存储。
APP_MEDIA_NAS_ENABLED=false
# 仅接入独立 NAS 媒体服务时填写。
APP_MEDIA_NAS_BASE_URL=
APP_MEDIA_NAS_CALLBACK_BASE_URL=
APP_MEDIA_LOCAL_WORKSPACE_DIR=
APP_MEDIA_LOCAL_SUBPROCESS_TIMEOUT=1h
APP_MEDIA_LOCAL_MAX_CONCURRENT_JOBS=1
APP_MEDIA_LOCAL_ENABLE_HLS_PARALLEL_DOWNLOAD=true
APP_MEDIA_LOCAL_HLS_DOWNLOAD_CONCURRENCY=16
APP_MEDIA_LOCAL_HLS_DOWNLOAD_TIMEOUT=30s
APP_MEDIA_LOCAL_HLS_DOWNLOAD_MAX_ATTEMPTS=3

# ---- 对象存储 MinIO ----
# MinIO 独立部署；根 compose 不会启动 MinIO 容器。
APP_MEDIA_STORAGE_PROVIDER=minio
APP_MEDIA_STORAGE_KEY_PREFIX=media
APP_MEDIA_STORAGE_PUBLIC_BASE_URL=
APP_MEDIA_STORAGE_UPLOAD_URL_EXPIRATION=10m
APP_MEDIA_STORAGE_UPLOAD_MAX_SIZE=1GB
# 后端容器使用的地址，可填写内网地址或与外部地址相同的 HTTPS 地址。
APP_MEDIA_MINIO_INTERNAL_ENDPOINT=https://s3.example.com
# 浏览器预签名直传和公开媒体访问使用的公网 HTTPS 地址。
APP_MEDIA_MINIO_EXTERNAL_ENDPOINT=https://s3.example.com
APP_MEDIA_MINIO_ACCESS_KEY=please_fill_minio_access_key
APP_MEDIA_MINIO_SECRET_KEY=please_fill_minio_secret_key
APP_MEDIA_MINIO_BUCKET=koi-commune

# ---- 初始化 AI 模型（按需启用）----
APP_AI_BOOTSTRAP_ENABLED=false
APP_AI_BOOTSTRAP_MODEL_KEY=
APP_AI_BOOTSTRAP_BASE_URL=
APP_AI_BOOTSTRAP_MODEL_NAME=
APP_AI_BOOTSTRAP_DISPLAY_NAME=
APP_AI_BOOTSTRAP_API_KEY=
APP_AI_BOOTSTRAP_MODEL_ENABLED=true
APP_AI_BOOTSTRAP_CURRENCY=CREDIT
APP_AI_BOOTSTRAP_BILLING_UNIT_TOKENS=1000
APP_AI_BOOTSTRAP_INPUT_TOKEN_UNIT_PRICE=
APP_AI_BOOTSTRAP_OUTPUT_TOKEN_UNIT_PRICE=
APP_AI_BOOTSTRAP_CACHED_INPUT_TOKEN_UNIT_PRICE=
APP_AI_BOOTSTRAP_MAX_CONTEXT_TOKENS=
APP_AI_BOOTSTRAP_MAX_OUTPUT_TOKENS=
APP_AI_BOOTSTRAP_REQUEST_TIMEOUT_MS=60000
APP_AI_BOOTSTRAP_SORT_ORDER=0
APP_AI_BOOTSTRAP_REMARK=

# ---- 根 compose 可选覆盖项 ----
# POSTGRES_USER=appuser
# POSTGRES_DB=appdb
# TZ=Asia/Shanghai
# SPRING_PROFILES_ACTIVE=dev
# KOI_API_BASE_URL=/backend
# KOI_WEAPP_API_BASE_URL=https://api.koimune.com
# BACKEND_PORT=127.0.0.1:8080
# WEB_PORT=127.0.0.1:3000
